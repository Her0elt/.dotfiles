# nix first: `brew shellenv` (~/.zprofile) runs path_helper, which pushes nix paths behind /usr/bin
export PATH="/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:$PATH"
export XDG_CONFIG_HOME=$HOME/.config
export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:~/.local/share/zig/
export PATH=$PATH:~/.local/bin/tmux-cli
bindkey -s ^f "~/.local/bin/tmux-wrapper project \n"
export DOTFILES=$HOME/.dotfiles
# export PATH="$HOME/.dotnet/tools:$PATH"
export GIT_EDITOR=nvim
export EDITOR=$GIT_EDITOR
export VISUAL=$GIT_EDITOR
export PATH="/Users/hermannelton/fvm/bin:$PATH"



